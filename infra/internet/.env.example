# Required: real DNS/DDNS hostname for this Internet-facing host.
NOVA_PUBLIC_HOST=

# Required: generate a unique random secret (at least 32 characters).
# Keep it private and identical for Rendezvous and coturn.
NOVA_TURN_SHARED_SECRET=

# Required: password for the PKCS#12 certificate mounted at certs/rendezvous.pfx.
NOVA_TLS_PFX_PASSWORD=

# Required by the native Windows manager: path to a Windows-native coturn
# turnserver.exe built with TLS support (OpenSSL 3 or newer).
NOVA_COTURN_EXECUTABLE=infra\internet\coturn\bin\turnserver.exe

# Filled by manage-windows.ps1 from the hostname's single public A record and
# the Windows host's default-route interface when starting the deployment.
NOVA_TURN_EXTERNAL_IP=
NOVA_TURN_INTERNAL_IP=

# Operational limits; increase deliberately for a large shared deployment.
NOVA_MAX_ONLINE_DEVICES=5000
NOVA_CONNECTS_PER_IP_PER_MINUTE=30
# Maximum accepted file size for the separate WSS/TCP-TLS relay (default 100 GiB; maximum 1 TiB).
NOVA_MAX_RELAY_FILE_BYTES=107374182400
