# Public DNS name with A/AAAA records for this Internet-facing host.
NOVA_PUBLIC_HOST=network.example.net

# Generate with: openssl rand -base64 48
# Keep this value private and identical for Rendezvous and coturn.
NOVA_TURN_SHARED_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Password for the PKCS#12 certificate mounted at certs/rendezvous.pfx.
NOVA_TLS_PFX_PASSWORD=replace-me

# Operational limits; increase deliberately for a large shared deployment.
NOVA_MAX_ONLINE_DEVICES=5000
NOVA_CONNECTS_PER_IP_PER_MINUTE=30
