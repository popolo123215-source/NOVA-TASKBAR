                          <Button Tag="{Binding}" Content="Изменить" Click="ProductivityMemoryEdit_Click" Style="{StaticResource SmallButton}" Padding="7,4" Margin="0,0,5,0"/>
                          <Button Tag="{Binding}" Content="Удалить" Click="ProductivityMemoryDelete_Click" IsEnabled="{Binding CanDelete}" Style="{StaticResource SmallButton}" Padding="7,4"/>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
