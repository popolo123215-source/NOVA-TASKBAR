<Window x:Class="Nova.WindowsClient.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Панель NOVA" Width="386" Height="316" MinWidth="320" MinHeight="88" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" Loaded="Window_Loaded" Closing="Window_Closing" SizeChanged="Window_SizeChanged">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource NavButton}"><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
    <Style x:Key="TitleText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Window.Resources>
  <Border x:Name="PanelSurface" Margin="10" CornerRadius="24" BorderThickness="1" BorderBrush="#30FFFFFF" Opacity="0.96">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F4161D30"/><GradientStop Color="#F00D1220" Offset="1"/></LinearGradientBrush></Border.Background>
    <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="7" Opacity="0.42" Color="#050711"/></Border.Effect>
    <Grid>
      <Grid x:Name="CompactView" Margin="17" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="42" Height="42" CornerRadius="15" VerticalAlignment="Center"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B49BFF"/><GradientStop Color="#5BC5FF" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="N" FontSize="22" FontWeight="Bold" Foreground="#111528" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center"><TextBlock Text="NOVA" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="15"/><TextBlock Text="Устройства под рукой" Foreground="{StaticResource MutedInk}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
        <Button Grid.Column="2" Style="{StaticResource SmallButton}" Content="···" ToolTip="Открыть панель" Click="CompactOpen_Click" Margin="4,0"/>
        <Button Grid.Column="3" Style="{StaticResource SmallButton}" Content="×" ToolTip="Скрыть в область уведомлений" Click="Hide_Click"/>
      </Grid>
      <Grid x:Name="MainView" Margin="22" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel LastChildFill="True" MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource SmallButton}" Content="⚙" ToolTip="Настройки" Click="Settings_Click" Margin="3,0"/><Button Style="{StaticResource SmallButton}" Content="—" ToolTip="Компактный вид" Click="Compact_Click" Margin="3,0"/><Button Style="{StaticResource SmallButton}" Content="×" ToolTip="Скрыть в область уведомлений" Click="Hide_Click" Margin="3,0,0,0"/></StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" CornerRadius="12" Margin="0,0,11,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B49BFF"/><GradientStop Color="#5BC5FF" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="N" FontSize="19" FontWeight="Bold" Foreground="#111528" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="NOVA" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="15"/><TextBlock Text="ПАНЕЛЬ" Foreground="{StaticResource MutedInk}" FontSize="9" FontWeight="SemiBold"/></StackPanel></StackPanel>
        </DockPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="#66D9B5" Margin="0,0,7,0"/><TextBlock Text="Этот компьютер" Foreground="{StaticResource PanelInk}" FontSize="12"/><TextBlock Text="  ·  " Foreground="{StaticResource MutedInk}" FontSize="12"/><TextBlock Text="Готов к подключению" Foreground="{StaticResource MutedInk}" FontSize="12"/></StackPanel>
        <UniformGrid Grid.Row="3" Rows="1" Columns="3" Margin="0,18,0,10">
          <Button Style="{StaticResource NavButton}" Click="Transfers_Click" Margin="0,0,7,0"><StackPanel><TextBlock Text="↗" Foreground="#B49BFF" FontSize="22"/><TextBlock Text="Передача" FontWeight="SemiBold" Margin="0,12,0,3"/><TextBlock Text="Файлы и ссылки" Foreground="{StaticResource MutedInk}" FontSize="10"/></StackPanel></Button>
          <Button Style="{StaticResource NavButton}" Click="History_Click" Margin="4,0"><StackPanel><TextBlock Text="◷" Foreground="#70C9FF" FontSize="22"/><TextBlock Text="История" FontWeight="SemiBold" Margin="0,12,0,3"/><TextBlock Text="Последние события" Foreground="{StaticResource MutedInk}" FontSize="10"/></StackPanel></Button>
          <Button Style="{StaticResource NavButton}" Click="Remote_Click" Margin="7,0,0,0"><StackPanel><TextBlock Text="⌘" Foreground="#FFB882" FontSize="22"/><TextBlock Text="Удалённо" FontWeight="SemiBold" Margin="0,12,0,3"/><TextBlock Text="Управление ПК" Foreground="{StaticResource MutedInk}" FontSize="10"/></StackPanel></Button>
        </UniformGrid>
        <DockPanel Grid.Row="4" LastChildFill="False"><TextBlock Text="Разделы в разработке" Foreground="{StaticResource MutedInk}" FontSize="11" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Ещё  →" Click="Expand_Click"/></DockPanel>
      </Grid>
      <Grid x:Name="ExpandedView" Margin="22" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel MouseLeftButtonDown="DragSurface_MouseLeftButtonDown"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource SmallButton}" Content="—" ToolTip="Основная панель" Click="Main_Click" Margin="3,0"/><Button Style="{StaticResource SmallButton}" Content="×" ToolTip="Скрыть в область уведомлений" Click="Hide_Click" Margin="3,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" CornerRadius="12" Margin="0,0,11,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B49BFF"/><GradientStop Color="#5BC5FF" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="N" FontSize="19" FontWeight="Bold" Foreground="#111528" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="NOVA" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="15"/><TextBlock Text="ВАШИ УСТРОЙСТВА" Foreground="{StaticResource MutedInk}" FontSize="9" FontWeight="SemiBold"/></StackPanel></StackPanel></DockPanel>
        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,17,0,13"><Button Style="{StaticResource SmallButton}" Content="Обзор" Click="Overview_Click" Margin="0,0,4,0"/><Button Style="{StaticResource SmallButton}" Content="Передача" Click="Transfers_Click" Margin="3,0"/><Button Style="{StaticResource SmallButton}" Content="История" Click="History_Click" Margin="3,0"/><Button Style="{StaticResource SmallButton}" Content="Настройки" Click="Settings_Click" Margin="4,0,0,0"/></UniformGrid>
        <Grid Grid.Row="2">
          <StackPanel x:Name="OverviewContent" VerticalAlignment="Center"><TextBlock Text="Всё для работы с устройствами NOVA." Foreground="{StaticResource Ink}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Подключите устройства NOVA, чтобы держать всё нужное под рукой." Foreground="{StaticResource MutedInk}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,18"/><Border CornerRadius="16" Background="#16FFFFFF" Padding="14"><DockPanel><Border Width="36" Height="36" CornerRadius="12" Background="#22A991FF" DockPanel.Dock="Left"><TextBlock Text="✦" Foreground="#C4B5FF" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="Ядро NOVA" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Архитектура подготовлена · сервис не подключён" Foreground="{StaticResource MutedInk}" FontSize="10" Margin="0,3,0,0"/></StackPanel></DockPanel></Border></StackPanel>
          <StackPanel x:Name="ModuleContent" Visibility="Collapsed" VerticalAlignment="Center"><TextBlock x:Name="ModuleTitle" Text="Передача" Style="{StaticResource TitleText}"/><TextBlock x:Name="ModuleDescription" Text="Передача файлов и ссылок появится в следующих версиях." Foreground="{StaticResource MutedInk}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,18"/><Border CornerRadius="14" Background="#16FFFFFF" Padding="13"><TextBlock x:Name="ModuleStatus" Text="Модуль в разработке · пока недоступен" Foreground="{StaticResource PanelInk}" FontSize="12"/></Border></StackPanel>
          <ScrollViewer x:Name="TransferContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Устройства в локальной сети" Foreground="{StaticResource Ink}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,7"/>
              <TextBlock Text="NOVA Network" Foreground="{StaticResource Ink}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
              <DockPanel Margin="0,0,0,2"><Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Подключить" Click="ConnectInternet_Click" Margin="6,0,0,0"/><TextBox x:Name="InternetEndpointBox" Text="" ToolTip="wss://host.example/v1/connect" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,4" FontSize="10"/></DockPanel>
              <TextBlock x:Name="InternetStatusText" Text="Internet Mode отключён" Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,7"/>
              <TextBlock Text="Устройства рядом и через Internet" Foreground="{StaticResource Ink}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,7"/>
              <ListBox x:Name="DevicesList" Height="82" SelectionChanged="DevicesList_SelectionChanged" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" BorderThickness="1">
                <ListBox.ItemTemplate><DataTemplate><Grid Margin="2,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding AvailabilityText}" Foreground="{StaticResource MutedInk}" FontSize="9" Margin="0,2,0,0"/><TextBlock Text="{Binding ShortFingerprint}" Foreground="{StaticResource MutedInk}" FontSize="9" Margin="0,2,0,0"/></StackPanel><TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Не подтверждено"/><Setter Property="Foreground" Value="#FFCC94"/><Style.Triggers><DataTrigger Binding="{Binding IsTrusted}" Value="True"><Setter Property="Text" Value="Доверенное"/><Setter Property="Foreground" Value="#66D9B5"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="Мой код безопасности" Foreground="{StaticResource PanelInk}" FontSize="11" Margin="0,8,0,3"/>
              <TextBox x:Name="LocalFingerprintText" IsReadOnly="True" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="8,5" FontSize="10"/>
              <TextBlock Text="Код устройства для доверенного обмена" Foreground="{StaticResource PanelInk}" FontSize="10" Margin="0,6,0,3"/>
              <DockPanel Margin="0,0,0,5"><TextBox x:Name="LocalPairingCodeBox" IsReadOnly="True" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,4" FontSize="9"/><Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Копировать" Click="CopyPairingCode_Click" Margin="5,0,0,0"/></DockPanel>
              <DockPanel Margin="0,0,0,6"><TextBox x:Name="PairingCodeBox" ToolTip="Вставьте код NOVA1: от второго устройства" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,4" FontSize="9"/><Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Доверить" Click="TrustInternetCode_Click" Margin="5,0,0,0"/></DockPanel>
              <TextBlock Text="Сверьте полный код с выбранным устройством на обоих компьютерах. Доверяйте только знакомому устройству." Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,6"/>
              <WrapPanel Margin="0,0,0,8"><Button Style="{StaticResource SmallButton}" Content="Подтвердить устройство" Click="TrustDevice_Click" Margin="0,0,6,0"/><Button Style="{StaticResource SmallButton}" Content="Выбрать файлы" Click="ChooseFiles_Click"/></WrapPanel>
              <TextBlock Text="Папка получения" Foreground="{StaticResource PanelInk}" FontSize="11"/>
              <DockPanel Margin="0,3,0,9"><TextBlock x:Name="DestinationPathText" Foreground="{StaticResource MutedInk}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Изменить…" Click="ChooseDestination_Click" Margin="8,0,0,0"/></DockPanel>
              <ListBox x:Name="OutgoingFilesList" Height="70" DisplayMemberPath="DisplayText" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF"/>
              <Button Style="{StaticResource SmallButton}" Content="Отправить выбранному устройству" Click="SendFiles_Click" HorizontalAlignment="Stretch" Margin="0,7,0,5"/>
              <Button Style="{StaticResource SmallButton}" Content="Отправить через WebRTC" Click="SendWebRtcFiles_Click" HorizontalAlignment="Stretch" Margin="0,0,0,5"/>
              <ListBox x:Name="TransferProgressList" Height="72" DisplayMemberPath="DisplayText" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Margin="0,0,0,10"/>
              <Button Style="{StaticResource SmallButton}" Content="Отменить выбранную WebRTC передачу" Click="CancelWebRtcTransfer_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
              <TextBlock Text="Входящие файлы" Foreground="{StaticResource Ink}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
              <ListBox x:Name="IncomingOffersList" Height="76" DisplayMemberPath="DisplayText" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF"/>
              <WrapPanel Margin="0,6,0,10"><Button Style="{StaticResource SmallButton}" Content="Принять" Click="AcceptIncoming_Click" Margin="0,0,6,0"/><Button Style="{StaticResource SmallButton}" Content="Отклонить" Click="RejectIncoming_Click"/></WrapPanel>
              <TextBlock x:Name="TransferStatusText" Text="Поиск устройств…" Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="HistoryContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel><TextBlock Text="Последние передачи" Foreground="{StaticResource Ink}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,9"/><ListBox x:Name="HistoryList" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" DisplayMemberPath="DisplayText"/></StackPanel>
          </ScrollViewer>
          <StackPanel x:Name="SettingsContent" Visibility="Collapsed"><TextBlock Text="Настройки панели" Style="{StaticResource TitleText}" Margin="0,0,0,12"/><TextBlock Text="Размер панели" Foreground="{StaticResource PanelInk}" FontSize="12"/><Slider x:Name="SizeSlider" Minimum="0.8" Maximum="1.2" Value="1" ValueChanged="SizeSlider_ValueChanged" Margin="0,1,0,8"/><TextBlock Text="Прозрачность панели" Foreground="{StaticResource PanelInk}" FontSize="12"/><Slider x:Name="OpacitySlider" Minimum="0.72" Maximum="1" Value="0.96" ValueChanged="OpacitySlider_ValueChanged" Margin="0,1,0,7"/><TextBlock Text="Положение у края" Foreground="{StaticResource PanelInk}" FontSize="12" Margin="0,4,0,7"/><UniformGrid Rows="1" Columns="4"><Button Style="{StaticResource SmallButton}" Content="Сверху" Click="DockTop_Click" Margin="0,0,4,0"/><Button Style="{StaticResource SmallButton}" Content="Снизу" Click="DockBottom_Click" Margin="3,0"/><Button Style="{StaticResource SmallButton}" Content="Слева" Click="DockLeft_Click" Margin="3,0"/><Button Style="{StaticResource SmallButton}" Content="Справа" Click="DockRight_Click" Margin="4,0,0,0"/></UniformGrid></StackPanel>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,15,0,0"><TextBlock Text="NOVA  ·  КОНФИДЕНЦИАЛЬНОСТЬ ВАЖНА" Foreground="#78859F" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Назад" Click="Main_Click"/></DockPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
