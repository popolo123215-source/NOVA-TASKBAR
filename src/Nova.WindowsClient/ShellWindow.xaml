                  </DockPanel>
                  <TextBlock x:Name="WeatherSearchStatusText" Text="Найдите город и выберите нужный регион." Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
                  <ListBox x:Name="WeatherSearchResults" Height="82" DisplayMemberPath="DisplayName" SelectionChanged="WeatherSearchResults_SelectionChanged" Background="#FF080808" Foreground="{StaticResource Ink}" BorderBrush="#FF202020" Margin="0,0,0,10"/>
                  <TextBlock Text="Интервал обновления (минуты)" Foreground="{StaticResource PanelInk}" FontSize="12"/>
                  <DockPanel><TextBlock x:Name="WeatherRefreshValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedInk}" FontSize="10" VerticalAlignment="Center"/><Slider x:Name="WeatherRefreshSlider" Minimum="5" Maximum="60" Value="15" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SettingsSlider_ValueChanged" Margin="0,1,8,0"/></DockPanel>
                </StackPanel>
                <StackPanel x:Name="GamingSettingsPanel" Visibility="Collapsed">
                  <TextBlock Text="Gaming" Style="{StaticResource TitleText}" Margin="0,0,0,12"/>
                  <Button x:Name="GamingOverlayButton" Style="{StaticResource SmallButton}" Content="Включить игровой оверлей" Click="GamingOverlay_Click" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                  <TextBlock Text="Размер оверлея" Foreground="{StaticResource PanelInk}" FontSize="12"/>
                  <Slider x:Name="OverlaySizeSlider" Minimum="0.8" Maximum="1.6" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="OverlaySizeSlider_ValueChanged" Margin="0,1,0,9"/>
                  <TextBlock Text="Показатели оверлея" Foreground="{StaticResource PanelInk}" FontSize="12"/>
                  <CheckBox x:Name="ShowOverlayCpuCheckBox" Content="CPU" Foreground="{StaticResource Ink}" Margin="0,5,0,3" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="ShowOverlayGpuCheckBox" Content="GPU · 3D" Foreground="{StaticResource Ink}" Margin="0,3" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="ShowOverlayRamCheckBox" Content="RAM" Foreground="{StaticResource Ink}" Margin="0,3,0,8" Click="SettingsOption_Click"/>
                  <TextBlock Text="Прозрачный режим пропускает ввод мыши и скрывает обычную панель. Для перемещения используйте меню NOVA в трее." Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="MonitoringSettingsPanel" Visibility="Collapsed">
                  <TextBlock Text="Monitoring" Style="{StaticResource TitleText}" Margin="0,0,0,12"/>
                  <TextBlock Text="Показатели в компактной капсуле" Foreground="{StaticResource PanelInk}" FontSize="12"/>
                  <CheckBox x:Name="ShowCapsuleCpuCheckBox" Content="CPU" Foreground="{StaticResource Ink}" Margin="0,6,0,3" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="ShowCapsuleGpuCheckBox" Content="GPU · 3D" Foreground="{StaticResource Ink}" Margin="0,3" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="ShowCapsuleRamCheckBox" Content="RAM" Foreground="{StaticResource Ink}" Margin="0,3,0,10" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="ShowCapsuleNetworkCheckBox" Content="Скорость сети" Foreground="{StaticResource Ink}" Margin="0,3" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="ShowCapsuleVpnCheckBox" Content="Состояние адаптера Radmin VPN" ToolTip="Показывает только состояние локального адаптера Windows; доступность удалённого пользователя не проверяется." Foreground="{StaticResource Ink}" Margin="0,3,0,10" Click="SettingsOption_Click"/>
                  <TextBlock Text="Частота обновления показателей (секунды)" Foreground="{StaticResource PanelInk}" FontSize="12"/>
                  <DockPanel><TextBlock x:Name="SystemRefreshValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedInk}" FontSize="10" VerticalAlignment="Center"/><Slider x:Name="SystemRefreshSlider" Minimum="1" Maximum="10" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SettingsSlider_ValueChanged" Margin="0,2,8,8"/></DockPanel>
                  <TextBlock x:Name="MonitoringDescriptionText" Text="Показатели обновляются через Windows Performance Counters." Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel x:Name="AppearanceSettingsPanel" Visibility="Collapsed">
                  <TextBlock Text="Appearance" Style="{StaticResource TitleText}" Margin="0,0,0,12"/>
                  <CheckBox x:Name="EnableMotionCheckBox" Content="Плавные переходы и анимации" Foreground="{StaticResource Ink}" Margin="0,2,0,10" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="EnableAudioReactiveCheckBox" Content="Реакция капсулы на уровень звука" Foreground="{StaticResource Ink}" Margin="0,2,0,10" Click="SettingsOption_Click"/>
                  <TextBlock Text="Интенсивность аудиореакции" Foreground="{StaticResource PanelInk}" FontSize="12"/>
                  <DockPanel><TextBlock x:Name="AudioReactiveIntensityValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedInk}" FontSize="10" VerticalAlignment="Center"/><Slider x:Name="AudioReactiveIntensitySlider" Minimum="0.5" Maximum="2" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="SettingsSlider_ValueChanged" Margin="0,1,8,8"/></DockPanel>
                  <TextBlock Text="Поверхность остаётся глубоко-чёрной; эти параметры управляют только анимацией и реакцией." Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </Grid>
                </Grid>
              </ScrollViewer>
              <Thumb x:Name="WorkspaceResizeGrip" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6" Cursor="SizeNWSE" DragDelta="WorkspaceResizeGrip_DragDelta">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border Background="#D9F0A84B" CornerRadius="5" BorderBrush="#FFF7C37A" BorderThickness="1">
                      <TextBlock Text="◢" Foreground="#FF17191D" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Grid>
          </Border>
          <Border Grid.Column="1" CornerRadius="18" Background="#5613161B" BorderBrush="#2AFFFFFF" BorderThickness="1" Padding="10">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="ВИДЖЕТЫ" Foreground="{StaticResource MutedInk}" FontSize="9" FontWeight="SemiBold" Margin="5,2,5,6"/>
              <TextBlock DockPanel.Dock="Bottom" Text="F11 / Esc — полный экран" Foreground="{StaticResource MutedInk}" FontSize="8" Margin="5,6,5,0"/>
              <ItemsControl x:Name="WidgetNavigationList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource WidgetNavigationButton}" Tag="{Binding Id}" Click="WidgetNavigation_Click" ToolTip="{Binding Title}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Glyph}" Foreground="#FFF0A84B" FontSize="17" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Ink}" FontSize="9" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="28" Margin="0,2,0,0"/>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,8,2,0">
          <TextBlock x:Name="WorkspaceFooterText" Text="NOVA · РАБОЧЕЕ ПРОСТРАНСТВО" Foreground="#A1A7B3" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Быстрые функции" Click="Main_Click" Padding="8,5"/>
        </DockPanel>
      </Grid>
      <Grid x:Name="GamingOverlayView" Visibility="Collapsed" Margin="8,5">
        <StackPanel VerticalAlignment="Center">
          <DockPanel x:Name="OverlayCpuRow">
            <TextBlock Text="CPU" Foreground="#FFF1F1F1" FontSize="10" FontWeight="SemiBold" Width="38" Effect="{StaticResource OverlayTextShadow}"/>
            <TextBlock x:Name="OverlayCpuText" Text="—" Foreground="#FFFFFFFF" FontSize="11" FontWeight="SemiBold" Effect="{StaticResource OverlayTextShadow}"/>
          </DockPanel>
          <DockPanel x:Name="OverlayGpuRow" Margin="0,2,0,0">
            <TextBlock Text="GPU" Foreground="#FFF1F1F1" FontSize="10" FontWeight="SemiBold" Width="38" Effect="{StaticResource OverlayTextShadow}"/>
            <TextBlock x:Name="OverlayGpuText" Text="—" Foreground="#FFFFFFFF" FontSize="11" FontWeight="SemiBold" Effect="{StaticResource OverlayTextShadow}"/>
          </DockPanel>
          <DockPanel x:Name="OverlayRamRow" Margin="0,2,0,0">
            <TextBlock Text="RAM" Foreground="#FFF1F1F1" FontSize="10" FontWeight="SemiBold" Width="38" Effect="{StaticResource OverlayTextShadow}"/>
            <TextBlock x:Name="OverlayRamText" Text="—" Foreground="#FFFFFFFF" FontSize="11" FontWeight="SemiBold" Effect="{StaticResource OverlayTextShadow}"/>
          </DockPanel>
        </StackPanel>
      </Grid>
      <Border x:Name="DragTrail" Margin="-5" CornerRadius="45" BorderBrush="#A991FF" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
  </Border>
</Window>
