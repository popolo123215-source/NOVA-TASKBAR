                    <ComboBoxItem Content="Авто · P2P / TURN / relay" Tag="Automatic"/>
                    <ComboBoxItem Content="Только Direct P2P" Tag="DirectP2P"/>
                    <ComboBoxItem Content="Только TURN UDP" Tag="TurnUdp"/>
                    <ComboBoxItem Content="Только TURN TCP" Tag="TurnTcp"/>
                    <ComboBoxItem Content="Только TURN TLS" Tag="TurnTls"/>
                    <ComboBoxItem Content="Только TCP/TLS relay" Tag="TcpTlsFileRelay"/>
                    <ComboBoxItem Content="Direct VPN · TCP/TLS" Tag="DirectVpn"/>
                  </ComboBox>
                </DockPanel>
                <StackPanel x:Name="DirectVpnEndpointPanel" Visibility="Collapsed">
                  <TextBlock x:Name="DirectVpnPortText" Text="Direct VPN: сетевой listener не запущен" Foreground="{StaticResource MutedInk}" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,2"/>
                  <TextBlock Text="IPv4 получателя и его TCP-порт (только Direct VPN)" Foreground="{StaticResource MutedInk}" FontSize="9" Margin="0,2,0,2"/>
                  <DockPanel Margin="0,0,0,3"><TextBox x:Name="DirectVpnAddressBox" ToolTip="Введите IPv4-адрес устройства в сети Radmin VPN" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,4" FontSize="9"/><TextBox x:Name="DirectVpnPortBox" Width="62" TextAlignment="Center" ToolTip="TCP-порт NOVA, показанный на устройстве-получателе" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="5,4" FontSize="9" Margin="5,0,0,0"/></DockPanel>
                </StackPanel>
                <WrapPanel Margin="0,5,0,5"><Button Style="{StaticResource SmallButton}" Content="LAN" Click="SendFiles_Click" Margin="0,0,5,0" Padding="10,5"/><Button x:Name="SendWebRtcFilesButton" Style="{StaticResource SmallButton}" Content="WebRTC / Internet" Click="SendWebRtcFiles_Click" Padding="10,5"/></WrapPanel>
                <TextBlock Text="Активность и маршрут" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,4"/>
                <ListBox x:Name="TransferProgressList" Height="72" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Margin="0,0,0,4">
                  <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayText}" Foreground="{StaticResource Ink}" FontSize="9" TextWrapping="Wrap" Margin="2"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Button Style="{StaticResource SmallButton}" Content="Отменить выбранную передачу" Click="CancelWebRtcTransfer_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8" Padding="8,5"/>
                <TextBlock Text="Входящие файлы" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ListBox x:Name="IncomingOffersList" Height="52" DisplayMemberPath="DisplayText" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF"/>
                <WrapPanel Margin="0,5,0,0"><Button Style="{StaticResource SmallButton}" Content="Принять" Click="AcceptIncoming_Click" Margin="0,0,5,0" Padding="9,5"/><Button Style="{StaticResource SmallButton}" Content="Отклонить" Click="RejectIncoming_Click" Padding="9,5"/></WrapPanel>
              </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="TransferStatusText" Grid.Row="1" Grid.ColumnSpan="2" Text="Поиск устройств…" Foreground="{StaticResource MutedInk}" FontSize="9" TextWrapping="Wrap" MaxHeight="34" Margin="0,5,0,0"/>
          </Grid>
          <ScrollViewer x:Name="HistoryContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel><TextBlock Text="Последние передачи" Foreground="{StaticResource Ink}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,9"/><ListBox x:Name="HistoryList" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" DisplayMemberPath="DisplayText"/></StackPanel>
          </ScrollViewer>
          <Grid x:Name="SettingsContent" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="138"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="SETTINGS" Foreground="{StaticResource MutedInk}" FontSize="10" FontWeight="SemiBold" Margin="8,2,0,9"/>
              <Button x:Name="SettingsGeneralButton" Style="{StaticResource SettingsNavButton}" Content="☷  General" Click="SettingsGeneral_Click"/>
              <Button x:Name="SettingsIslandButton" Style="{StaticResource SettingsNavButton}" Content="◉  Island" Click="SettingsIsland_Click"/>
              <Button x:Name="SettingsWeatherButton" Style="{StaticResource SettingsNavButton}" Content="☁  Weather" Click="SettingsWeather_Click"/>
              <Button x:Name="SettingsGamingButton" Style="{StaticResource SettingsNavButton}" Content="▣  Gaming" Click="SettingsGaming_Click"/>
              <Button x:Name="SettingsMonitoringButton" Style="{StaticResource SettingsNavButton}" Content="⌁  Monitoring" Click="SettingsMonitoring_Click"/>
              <Button x:Name="SettingsAppearanceButton" Style="{StaticResource SettingsNavButton}" Content="◐  Appearance" Click="SettingsAppearance_Click"/>
              <Button x:Name="SettingsProfilesButton" Style="{StaticResource SettingsNavButton}" Content="◎  Profiles" Click="SettingsProfiles_Click"/>
            </StackPanel>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Grid x:Name="SettingsSectionHost" Margin="5,0,2,0">
                <StackPanel x:Name="GeneralSettingsPanel" Visibility="Collapsed">
                  <TextBlock Text="General" Style="{StaticResource TitleText}" Margin="0,0,0,12"/>
                  <CheckBox x:Name="KeepOnTopCheckBox" Content="Поверх остальных окон" Foreground="{StaticResource Ink}" Margin="0,2,0,10" Click="SettingsOption_Click"/>
                  <TextBlock Text="Панель останется доступной из системного трея при скрытии." Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,14"/>
                  <CheckBox x:Name="TimerCompletionSoundCheckBox" Content="Звуковой сигнал по завершении таймера" Foreground="{StaticResource Ink}" Margin="0,2,0,10" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="BrowserAdaptationCheckBox" Content="Не перекрывать капсулу окнами браузеров" Foreground="{StaticResource Ink}" Margin="0,2,0,6" Click="SettingsOption_Click"/>
                  <TextBlock x:Name="BrowserAdaptationStatusText" Text="Windows API перемещает или изменяет размеры окон поддерживаемых браузеров. Полноэкранный и защищённый контент могут ограничивать управление." Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="IslandSettingsPanel" Visibility="Collapsed">
                  <TextBlock Text="Island" Style="{StaticResource TitleText}" Margin="0,0,0,12"/>
                  <TextBlock Text="Размер капсулы" Foreground="{StaticResource PanelInk}" FontSize="12"/>
                  <Slider x:Name="SizeSlider" Minimum="0.75" Maximum="1.1" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="SizeSlider_ValueChanged" Margin="0,1,0,9"/>
                  <TextBlock Text="Поведение при наведении" Foreground="{StaticResource PanelInk}" FontSize="12"/>
                  <CheckBox x:Name="HoverExpandCheckBox" Content="Раскрывать быстрые действия при наведении" Foreground="{StaticResource Ink}" Margin="0,5,0,4" Click="SettingsOption_Click"/>
                  <TextBlock Text="Задержка перед сворачиванием" Foreground="{StaticResource PanelInk}" FontSize="12" Margin="0,5,0,0"/>
                  <DockPanel><TextBlock x:Name="HoverCollapseDelayValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedInk}" FontSize="10" VerticalAlignment="Center"/><Slider x:Name="HoverCollapseDelaySlider" Minimum="250" Maximum="1500" Value="420" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="SettingsSlider_ValueChanged" Margin="0,1,8,8"/></DockPanel>
                  <TextBlock Text="Закрепление" Foreground="{StaticResource PanelInk}" FontSize="12" Margin="0,4,0,7"/>
                  <UniformGrid Rows="1" Columns="4">
                    <Button Style="{StaticResource SmallButton}" Content="Сверху" ToolTip="Вертикальная компоновка панели" Click="DockTop_Click" Margin="0,0,4,0" Padding="5,6"/>
                    <Button Style="{StaticResource SmallButton}" Content="Снизу" ToolTip="Вертикальная компоновка панели" Click="DockBottom_Click" Margin="2,0" Padding="5,6"/>
                    <Button Style="{StaticResource SmallButton}" Content="Слева" ToolTip="Горизонтальная компоновка панели" Click="DockLeft_Click" Margin="2,0" Padding="5,6"/>
                    <Button Style="{StaticResource SmallButton}" Content="Справа" ToolTip="Горизонтальная компоновка панели" Click="DockRight_Click" Margin="4,0,0,0" Padding="5,6"/>
                  </UniformGrid>
                  <TextBlock x:Name="DockStatusText" Text="Закреплена сверху." Foreground="{StaticResource MutedInk}" FontSize="10" Margin="0,7,0,0"/>
                  <TextBlock Text="Расположение элементов капсулы" Foreground="{StaticResource PanelInk}" FontSize="12" Margin="0,14,0,4"/>
                  <ComboBox x:Name="CapsuleLayoutCombo" SelectionChanged="CapsuleLayout_SelectionChanged" Height="27" Background="#1EFFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" FontSize="9">
                    <ComboBoxItem Content="Время · погода · музыка · показатели" Tag="ClockWeatherMediaStatus"/>
                    <ComboBoxItem Content="Музыка · время · погода · показатели" Tag="MediaClockWeatherStatus"/>
                    <ComboBoxItem Content="Погода · время · музыка · показатели" Tag="WeatherClockMediaStatus"/>
                    <ComboBoxItem Content="Показатели · музыка · время · погода" Tag="StatusMediaClockWeather"/>
                  </ComboBox>
                  <CheckBox x:Name="ShowCapsuleClockCheckBox" Content="Время и дата" Foreground="{StaticResource Ink}" Margin="0,9,0,3" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="ShowCapsuleWeatherCheckBox" Content="Погода" Foreground="{StaticResource Ink}" Margin="0,3" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="ShowCapsuleMediaCheckBox" Content="Название трека и исполнитель" Foreground="{StaticResource Ink}" Margin="0,3" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="ShowCapsuleArtworkCheckBox" Content="Обложка (если доступна)" Foreground="{StaticResource Ink}" Margin="0,3" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="ShowCapsulePlaybackCheckBox" Content="Статус воспроизведения" Foreground="{StaticResource Ink}" Margin="0,3,0,2" Click="SettingsOption_Click"/>
                </StackPanel>
                <StackPanel x:Name="WeatherSettingsPanel" Visibility="Collapsed">
                  <TextBlock Text="Weather" Style="{StaticResource TitleText}" Margin="0,0,0,12"/>
                  <TextBlock Text="Город для текущей погоды" Foreground="{StaticResource PanelInk}" FontSize="12"/>
                  <DockPanel Margin="0,4,0,5">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Найти" Click="SearchWeatherLocations_Click" Margin="6,0,0,0" Padding="8,5"/>
                    <TextBox x:Name="CityBox" Text="" ToolTip="Например, Москва" KeyDown="CityBox_KeyDown" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="8,5"/>
                  </DockPanel>
                  <TextBlock x:Name="WeatherSearchStatusText" Text="Найдите город и выберите нужный регион." Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
                  <ListBox x:Name="WeatherSearchResults" Height="82" DisplayMemberPath="DisplayName" SelectionChanged="WeatherSearchResults_SelectionChanged" Background="#FF080808" Foreground="{StaticResource Ink}" BorderBrush="#FF202020" Margin="0,0,0,10"/>
                  <TextBlock Text="Интервал обновления (минуты)" Foreground="{StaticResource PanelInk}" FontSize="12"/>
                  <DockPanel><TextBlock x:Name="WeatherRefreshValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedInk}" FontSize="10" VerticalAlignment="Center"/><Slider x:Name="WeatherRefreshSlider" Minimum="5" Maximum="60" Value="15" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SettingsSlider_ValueChanged" Margin="0,1,8,0"/></DockPanel>
                </StackPanel>
                <StackPanel x:Name="GamingSettingsPanel" Visibility="Collapsed">
                  <TextBlock Text="Gaming" Style="{StaticResource TitleText}" Margin="0,0,0,12"/>
                  <Button x:Name="GamingOverlayButton" Style="{StaticResource SmallButton}" Content="Включить игровой оверлей" Click="GamingOverlay_Click" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                  <TextBlock Text="Размер оверлея" Foreground="{StaticResource PanelInk}" FontSize="12"/>
                  <Slider x:Name="OverlaySizeSlider" Minimum="0.8" Maximum="1.6" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="OverlaySizeSlider_ValueChanged" Margin="0,1,0,9"/>
                  <TextBlock Text="Показатели оверлея" Foreground="{StaticResource PanelInk}" FontSize="12"/>
                  <CheckBox x:Name="ShowOverlayCpuCheckBox" Content="CPU" Foreground="{StaticResource Ink}" Margin="0,5,0,3" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="ShowOverlayGpuCheckBox" Content="GPU · 3D" Foreground="{StaticResource Ink}" Margin="0,3" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="ShowOverlayRamCheckBox" Content="RAM" Foreground="{StaticResource Ink}" Margin="0,3,0,8" Click="SettingsOption_Click"/>
                  <TextBlock Text="Прозрачный режим пропускает ввод мыши и скрывает обычную панель. Для перемещения используйте меню NOVA в трее." Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="MonitoringSettingsPanel" Visibility="Collapsed">
                  <TextBlock Text="Monitoring" Style="{StaticResource TitleText}" Margin="0,0,0,12"/>
                  <TextBlock Text="Показатели системного монитора" Foreground="{StaticResource PanelInk}" FontSize="12"/>
                  <CheckBox x:Name="ShowMonitorCpuCheckBox" Content="CPU · частота и температура" Foreground="{StaticResource Ink}" Margin="0,6,0,3" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="ShowMonitorGpuCheckBox" Content="GPU · частота, температура и VRAM" Foreground="{StaticResource Ink}" Margin="0,3" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="ShowMonitorRamCheckBox" Content="RAM · использование и доступно" Foreground="{StaticResource Ink}" Margin="0,3" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="ShowMonitorNetworkCheckBox" Content="Сеть · Download / Upload" Foreground="{StaticResource Ink}" Margin="0,3" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="ShowMonitorDiskCheckBox" Content="Диски · свободное место и I/O" Foreground="{StaticResource Ink}" Margin="0,3,0,10" Click="SettingsOption_Click"/>
                  <TextBlock Text="Показатели в компактной капсуле" Foreground="{StaticResource PanelInk}" FontSize="12"/>
                  <CheckBox x:Name="ShowCapsuleCpuCheckBox" Content="CPU" Foreground="{StaticResource Ink}" Margin="0,6,0,3" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="ShowCapsuleGpuCheckBox" Content="GPU · 3D" Foreground="{StaticResource Ink}" Margin="0,3" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="ShowCapsuleRamCheckBox" Content="RAM" Foreground="{StaticResource Ink}" Margin="0,3,0,10" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="ShowCapsuleNetworkCheckBox" Content="Скорость сети" Foreground="{StaticResource Ink}" Margin="0,3" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="ShowCapsuleVpnCheckBox" Content="Состояние адаптера Radmin VPN" ToolTip="Показывает только состояние локального адаптера Windows; доступность удалённого пользователя не проверяется." Foreground="{StaticResource Ink}" Margin="0,3,0,10" Click="SettingsOption_Click"/>
                  <TextBlock Text="Частота обновления показателей (секунды)" Foreground="{StaticResource PanelInk}" FontSize="12"/>
                  <DockPanel><TextBlock x:Name="SystemRefreshValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedInk}" FontSize="10" VerticalAlignment="Center"/><Slider x:Name="SystemRefreshSlider" Minimum="1" Maximum="10" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SettingsSlider_ValueChanged" Margin="0,2,8,8"/></DockPanel>
                  <TextBlock x:Name="MonitoringDescriptionText" Text="Показатели CPU, GPU, сети и дисков читаются из Windows; датчики температуры зависят от оборудования и драйвера." Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel x:Name="ProfilesSettingsPanel" Visibility="Collapsed">
                  <TextBlock Text="Profiles" Style="{StaticResource TitleText}" Margin="0,0,0,12"/>
                  <Border CornerRadius="12" Background="#18FFFFFF" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                      <TextBlock x:Name="ProfileCurrentText" Text="Текущий профиль: Default" Foreground="{StaticResource Ink}" FontSize="13" FontWeight="SemiBold"/>
                      <TextBlock x:Name="ProfileSourceText" Text="Источник: запасной профиль" Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                      <TextBlock x:Name="ProfilePendingText" Text="" Foreground="#FFF0A84B" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                  </Border>
                  <DockPanel Margin="0,0,0,6">
                    <ComboBox x:Name="ProfileQuickCombo" DockPanel.Dock="Left" Width="150" SelectionChanged="ProfileQuickCombo_SelectionChanged" Height="27"/>
                    <Button x:Name="ProfileResumeAutomationButton" Style="{StaticResource SmallButton}" Content="Возобновить автоматизацию" Click="ProfileResumeAutomation_Click" Margin="6,0,0,0" Padding="8,5"/>
                  </DockPanel>
                  <CheckBox x:Name="ProfileAutomationCheckBox" Content="Автоматическое переключение профилей" Foreground="{StaticResource Ink}" Margin="0,2,0,8" Click="ProfileAutomationCheckBox_Click"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,7,0">
                      <TextBlock Text="Профили" Foreground="{StaticResource PanelInk}" FontSize="12" FontWeight="SemiBold"/>
                      <ListBox x:Name="ProfileList" Height="128" SelectionChanged="ProfileList_SelectionChanged" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Margin="0,5,0,6"/>
                      <TextBox x:Name="ProfileNameBox" ToolTip="Название профиля" Text="" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,5" Margin="0,0,0,5"/>
                      <WrapPanel>
                        <Button Style="{StaticResource SmallButton}" Content="Создать" Click="ProfileCreate_Click" Margin="0,0,4,4" Padding="7,4"/>
                        <Button Style="{StaticResource SmallButton}" Content="Дублировать" Click="ProfileDuplicate_Click" Margin="0,0,4,4" Padding="7,4"/>
                        <Button Style="{StaticResource SmallButton}" Content="Переименовать" Click="ProfileRename_Click" Margin="0,0,4,4" Padding="7,4"/>
                        <Button Style="{StaticResource SmallButton}" Content="Удалить" Click="ProfileDelete_Click" Margin="0,0,4,4" Padding="7,4"/>
                        <Button Style="{StaticResource SmallButton}" Content="Включить" Click="ProfileActivate_Click" Margin="0,0,4,4" Padding="7,4"/>
                        <Button Style="{StaticResource SmallButton}" Content="Сохранить настройки" Click="ProfileCapture_Click" Margin="0,0,4,4" Padding="7,4"/>
                      </WrapPanel>
                      <TextBlock Text="История активации" Foreground="{StaticResource PanelInk}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,4"/>
                      <ListBox x:Name="ProfileHistoryList" Height="82" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Условия активации" Foreground="{StaticResource PanelInk}" FontSize="12" FontWeight="SemiBold"/>
                      <ComboBox x:Name="ProfileRuleKindCombo" Height="27" Margin="0,5,0,5">
                        <ComboBoxItem Content="Запущенный процесс" Tag="Process"/>
                        <ComboBoxItem Content="Расписание по времени" Tag="Time"/>
                        <ComboBoxItem Content="Полноэкранный режим" Tag="Fullscreen"/>
                        <ComboBoxItem Content="Аудиоустройство" Tag="AudioDevice"/>
                      </ComboBox>
                      <TextBox x:Name="ProfileRuleValueBox" ToolTip="Имя процесса, enabled/disabled или ID устройства" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,5" Margin="0,0,0,5"/>
                      <UniformGrid Rows="2" Columns="2" Margin="0,0,0,5">
                        <TextBox x:Name="ProfileRulePriorityBox" Text="100" ToolTip="Приоритет" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,4" Margin="0,0,4,4"/>
                        <TextBox x:Name="ProfileRuleDelayBox" Text="5" ToolTip="Задержка активации, сек" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,4" Margin="4,0,0,4"/>
                        <TextBox x:Name="ProfileRuleCooldownBox" Text="30" ToolTip="Cooldown, сек" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,4" Margin="0,0,4,0"/>
                        <TextBox x:Name="ProfileRuleWeekdaysBox" Text="1234567" ToolTip="Дни недели: 1–7" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,4" Margin="4,0,0,0"/>
                      </UniformGrid>
                      <DockPanel Margin="0,0,0,5">
                        <TextBox x:Name="ProfileRuleStartBox" Text="09:00" ToolTip="Начало" Width="76" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,4"/>
                        <TextBox x:Name="ProfileRuleEndBox" Text="18:00" ToolTip="Окончание" Width="76" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,4" Margin="5,0,0,0"/>
                      </DockPanel>
                      <WrapPanel Margin="0,0,0,6">
                        <Button Style="{StaticResource SmallButton}" Content="Добавить правило" Click="ProfileRuleAdd_Click" Margin="0,0,5,0" Padding="8,4"/>
                        <Button Style="{StaticResource SmallButton}" Content="Удалить правило" Click="ProfileRuleRemove_Click" Padding="8,4"/>
                      </WrapPanel>
                      <ListBox x:Name="ProfileRuleList" Height="126" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF"/>
                      <TextBlock x:Name="ProfileStatusText" Text="" Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
                <StackPanel x:Name="AppearanceSettingsPanel" Visibility="Collapsed">
                  <TextBlock Text="Appearance" Style="{StaticResource TitleText}" Margin="0,0,0,12"/>
                  <TextBlock Text="Размер значков виджетов (DIP)" Foreground="{StaticResource PanelInk}" FontSize="12"/>
                  <DockPanel><TextBlock x:Name="WidgetIconSizeValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedInk}" FontSize="10" VerticalAlignment="Center"/><Slider x:Name="WidgetIconSizeSlider" Minimum="20" Maximum="50" Value="24" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SettingsSlider_ValueChanged" Margin="0,1,8,8"/></DockPanel>
                  <CheckBox x:Name="EnableMotionCheckBox" Content="Плавные переходы и анимации" Foreground="{StaticResource Ink}" Margin="0,2,0,10" Click="SettingsOption_Click"/>
                  <CheckBox x:Name="EnableAudioReactiveCheckBox" Content="Реакция капсулы на уровень звука" Foreground="{StaticResource Ink}" Margin="0,2,0,10" Click="SettingsOption_Click"/>
                  <TextBlock Text="Интенсивность аудиореакции" Foreground="{StaticResource PanelInk}" FontSize="12"/>
                  <DockPanel><TextBlock x:Name="AudioReactiveIntensityValue" DockPanel.Dock="Right" Foreground="{StaticResource MutedInk}" FontSize="10" VerticalAlignment="Center"/><Slider x:Name="AudioReactiveIntensitySlider" Minimum="0.5" Maximum="2" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="SettingsSlider_ValueChanged" Margin="0,1,8,8"/></DockPanel>
                  <TextBlock Text="Поверхность остаётся глубоко-чёрной; эти параметры управляют только анимацией и реакцией." Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </Grid>
                </Grid>
              </ScrollViewer>
              <Thumb x:Name="WorkspaceResizeGrip" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6" Cursor="SizeNWSE" DragDelta="WorkspaceResizeGrip_DragDelta">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border Background="#D9F0A84B" CornerRadius="5" BorderBrush="#FFF7C37A" BorderThickness="1">
                      <TextBlock Text="◢" Foreground="#FF17191D" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Grid>
          </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,8,2,0">
          <TextBlock x:Name="WorkspaceFooterText" Text="NOVA · РАБОЧЕЕ ПРОСТРАНСТВО" Foreground="#A1A7B3" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="⌂" ToolTip="Домой · обзор NOVA" Click="HomeIsland_Click" Width="34" Height="30" Padding="4"/>
        </DockPanel>
      </Grid>
      <Grid x:Name="GamingOverlayView" Visibility="Collapsed" Margin="8,5">
        <StackPanel VerticalAlignment="Center">
          <DockPanel x:Name="OverlayCpuRow">
            <TextBlock Text="CPU" Foreground="#FFF1F1F1" FontSize="10" FontWeight="SemiBold" Width="38" Effect="{StaticResource OverlayTextShadow}"/>
            <TextBlock x:Name="OverlayCpuText" Text="—" Foreground="#FFFFFFFF" FontSize="11" FontWeight="SemiBold" Effect="{StaticResource OverlayTextShadow}"/>
          </DockPanel>
          <DockPanel x:Name="OverlayGpuRow" Margin="0,2,0,0">
            <TextBlock Text="GPU" Foreground="#FFF1F1F1" FontSize="10" FontWeight="SemiBold" Width="38" Effect="{StaticResource OverlayTextShadow}"/>
            <TextBlock x:Name="OverlayGpuText" Text="—" Foreground="#FFFFFFFF" FontSize="11" FontWeight="SemiBold" Effect="{StaticResource OverlayTextShadow}"/>
          </DockPanel>
          <DockPanel x:Name="OverlayRamRow" Margin="0,2,0,0">
            <TextBlock Text="RAM" Foreground="#FFF1F1F1" FontSize="10" FontWeight="SemiBold" Width="38" Effect="{StaticResource OverlayTextShadow}"/>
            <TextBlock x:Name="OverlayRamText" Text="—" Foreground="#FFFFFFFF" FontSize="11" FontWeight="SemiBold" Effect="{StaticResource OverlayTextShadow}"/>
          </DockPanel>
        </StackPanel>
      </Grid>
      <Border x:Name="DragTrail" Margin="-5" CornerRadius="45" BorderBrush="#A991FF" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
  </Border>
</Window>
