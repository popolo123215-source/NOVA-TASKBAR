<Window x:Class="Nova.WindowsClient.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Панель NOVA" Width="540" Height="84" MinWidth="380" MinHeight="64" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" Loaded="Window_Loaded" Closing="Window_Closing" SizeChanged="Window_SizeChanged" LocationChanged="Window_LocationChanged" PreviewKeyDown="Window_PreviewKeyDown" MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave" Deactivated="Window_Deactivated">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <Style TargetType="TextBlock"><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
    <Style x:Key="NovaScrollBarThumb" TargetType="{x:Type Thumb}">
      <Setter Property="Background" Value="#B8FFFFFF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Thumb}">
            <Grid Background="Transparent">
              <Ellipse Width="8" Height="8" Fill="{TemplateBinding Background}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NovaScrollBarPageButton" TargetType="{x:Type RepeatButton}">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RepeatButton}">
            <Border Background="{TemplateBinding Background}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="Transparent">
              <Border x:Name="ScrollRail" Width="2" Margin="0,6" HorizontalAlignment="Center" Background="#55FFFFFF" CornerRadius="1"/>
              <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton x:Name="PageDecreaseButton" Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource NovaScrollBarPageButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton x:Name="PageIncreaseButton" Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource NovaScrollBarPageButton}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource NovaScrollBarThumb}"/>
                </Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="12"/>
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                <Setter TargetName="PageDecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                <Setter TargetName="PageIncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                <Setter TargetName="ScrollRail" Property="Width" Value="Auto"/>
                <Setter TargetName="ScrollRail" Property="Height" Value="2"/>
                <Setter TargetName="ScrollRail" Property="Margin" Value="6,0"/>
                <Setter TargetName="ScrollRail" Property="HorizontalAlignment" Value="Stretch"/>
                <Setter TargetName="ScrollRail" Property="VerticalAlignment" Value="Center"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ScrollRail" Property="Background" Value="#88FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="#FF171A24"/>
      <Setter Property="BorderBrush" Value="#38FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="DropDownToggle"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Focusable="False"
                            ClickMode="Press"
                            Background="Transparent"
                            BorderThickness="0">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ComboBoxSurface"
                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            CornerRadius="8"
                            Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0"
                                          Margin="0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                        <TextBlock Grid.Column="1" Text="▾" Foreground="{StaticResource MutedInk}" FontSize="9"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ComboBoxSurface" Property="Background" Value="#FF252936"/>
                        <Setter TargetName="ComboBoxSurface" Property="BorderBrush" Value="#66FFFFFF"/>
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="ComboBoxSurface" Property="Background" Value="#FF303548"/>
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="ComboBoxSurface" Property="Opacity" Value="0.55"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="Popup"
                     Placement="Bottom"
                     AllowsTransparency="True"
                     PopupAnimation="Slide"
                     IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border x:Name="DropDownBorder"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="#FF171A24"
                        BorderBrush="#4FFFFFFF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="3">
                  <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="#A9A991FF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#7FFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="#FF34394A"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="#FF4A4165"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ItemSurface" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="#FF272B38"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="#FF4A4165"/>
                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#A9A991FF"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ItemSurface" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
      <Setter Property="SelectionBrush" Value="#A9A991FF"/>
      <Setter Property="Background" Value="#16FFFFFF"/>
      <Setter Property="BorderBrush" Value="#24FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,5"/>
    </Style>
    <DropShadowEffect x:Key="OverlayTextShadow" BlurRadius="2" ShadowDepth="1" Opacity="0.9" Color="#FF000000"/>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource NavButton}"><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
    <Style x:Key="TitleText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="SettingsNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}"><Setter Property="Padding" Value="8,7"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
    <Style x:Key="WidgetNavigationButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Background" Value="#35F0A84B"/>
          <Setter Property="BorderBrush" Value="#9AF0A84B"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="AdaptiveWidgetNavigationButton" TargetType="Button" BasedOn="{StaticResource WidgetNavigationButton}">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="AdaptiveWidgetNavigationTitle" TargetType="TextBlock">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontSize" Value="8"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <ItemsPanelTemplate x:Key="HorizontalWidgetNavigationPanel"><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="VerticalWidgetNavigationPanel"><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
  </Window.Resources>
  <Border x:Name="PanelSurface" Margin="0" CornerRadius="40" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
    <Grid>
      <Path x:Name="CapsuleGlowPath" Stroke="#A8F0A84B" StrokeThickness="5" Opacity="0.13" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SnapsToDevicePixels="True" IsHitTestVisible="False"/>
      <Path x:Name="CapsuleSurfacePath" Stroke="#FF51402F" StrokeThickness="1" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SnapsToDevicePixels="True" IsHitTestVisible="False">
        <Path.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF1B1B20" Offset="0"/>
            <GradientStop Color="#FF0C0C0F" Offset="0.48"/>
            <GradientStop Color="#FF050506" Offset="1"/>
          </LinearGradientBrush>
        </Path.Fill>
      </Path>
      <Grid x:Name="CompactView" Margin="18,10" Visibility="Collapsed">
        <Grid x:Name="CapsuleContentGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="CapsuleClockBlock" VerticalAlignment="Center" Margin="0,0,7,0">
            <TextBlock x:Name="ClockText" Text="--:--" Foreground="{StaticResource Ink}" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock x:Name="ClockDateText" Text="NOVA" Foreground="{StaticResource MutedInk}" FontSize="9" Margin="1,1,0,0"/>
          </StackPanel>
          <Border x:Name="CapsuleWeatherBlock" Grid.Column="1" Background="Transparent" CornerRadius="16" Padding="6,7" Margin="0,0,5,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="CompactWeatherIcon" Text="☁" Foreground="#AFC9FF" FontSize="19" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="CompactWeatherTemperature" Text="—°" Foreground="{StaticResource Ink}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock x:Name="CompactWeatherPlace" Text="Погода" Foreground="{StaticResource MutedInk}" FontSize="9" TextTrimming="CharacterEllipsis" MaxWidth="76"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Button x:Name="CompactMediaButton" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="5,4" Click="CompactMedia_Click" HorizontalContentAlignment="Stretch">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="CompactArtworkFrame" Width="34" Height="34" CornerRadius="10" Background="#FF101010" ClipToBounds="True" Visibility="Collapsed">
                <Image x:Name="CompactArtworkImage" Stretch="UniformToFill"/>
              </Border>
              <StackPanel x:Name="CompactMediaInfo" Grid.Column="1" Margin="8,0,2,0" VerticalAlignment="Center">
                <TextBlock x:Name="CompactMediaTitle" Text="Нет активного трека" Foreground="{StaticResource Ink}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CompactMediaArtist" Text="Ожидание медиасессии" Foreground="{StaticResource MutedInk}" FontSize="9" TextTrimming="CharacterEllipsis"/>
                <Grid x:Name="CompactLyricsBlock" Height="34" Margin="0,2,0,0" Visibility="Collapsed" ClipToBounds="True">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="10"/>
                  </Grid.RowDefinitions>
                  <ScrollViewer x:Name="CompactLyricPreviousViewport" Grid.Row="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False" HorizontalContentAlignment="Center">
                    <TextBlock x:Name="CompactLyricPrevious" Foreground="#88FFFFFF" FontSize="8" TextWrapping="NoWrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.72"/>
                  </ScrollViewer>
                  <ScrollViewer x:Name="CompactLyricCurrentViewport" Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False" HorizontalContentAlignment="Center">
                    <TextBlock x:Name="CompactLyricCurrent" Foreground="{StaticResource Ink}" FontSize="10" FontWeight="SemiBold" TextWrapping="NoWrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="1"/>
                  </ScrollViewer>
                  <ScrollViewer x:Name="CompactLyricNextViewport" Grid.Row="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False" HorizontalContentAlignment="Center">
                    <TextBlock x:Name="CompactLyricNext" Foreground="#88FFFFFF" FontSize="8" TextWrapping="NoWrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.72"/>
                  </ScrollViewer>
                </Grid>
              </StackPanel>
            </Grid>
          </Button>
          <Border x:Name="CapsuleStatusBlock" Grid.Column="3" Background="Transparent" CornerRadius="15" Padding="5,5,2,5" Margin="1,0,0,0" VerticalAlignment="Center">
            <DockPanel LastChildFill="True">
              <Button x:Name="CompactOpenButton" DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="⌄" ToolTip="Открыть панель и выбрать виджет" Click="CompactOpen_Click" Width="25" Height="28" Padding="0" Margin="3,0,0,0" FontSize="14"/>
              <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="ActivityDot" Width="6" Height="6" Fill="#63D7B3" VerticalAlignment="Center" Margin="0,0,5,0"/>
                  <TextBlock x:Name="CompactActivityText" Text="Готово" Foreground="{StaticResource PanelInk}" FontSize="9" VerticalAlignment="Center" MaxWidth="88" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock x:Name="CompactMetricsText" Text="" Foreground="{StaticResource MutedInk}" FontSize="8" TextWrapping="Wrap" MaxWidth="95" Margin="1,2,0,0"/>
                <TextBlock x:Name="CompactNetworkText" Text="" Foreground="#FFAFC9FF" FontSize="8" TextTrimming="CharacterEllipsis" MaxWidth="95" Margin="1,1,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="CompactVpnText" Text="" Foreground="#FFBFE4D9" FontSize="8" TextTrimming="CharacterEllipsis" MaxWidth="95" Margin="1,1,0,0" Visibility="Collapsed"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
      <Grid x:Name="ExpandedView" Margin="14" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="DockToggleButton" Style="{StaticResource SmallButton}" Content="⌖" ToolTip="Прикрепить к верхнему краю" Click="DockToggle_Click" Width="34" Height="30" Padding="4" Margin="3,0"/>
            <Button x:Name="WorkspaceModeToggleButton" Style="{StaticResource SmallButton}" Content="⤢" ToolTip="Расширить рабочее пространство" Click="WorkspaceModeToggle_Click" Width="34" Height="30" Padding="4" Margin="3,0"/>
            <Button x:Name="FullscreenToggleButton" Style="{StaticResource SmallButton}" Content="⛶  На весь экран" ToolTip="Открыть полноэкранное пространство" Click="ToggleFullscreen_Click" Margin="3,0"/>
            <Button Style="{StaticResource SmallButton}" Content="⌃" ToolTip="Свернуть до капсулы" Click="CollapseToCapsule_Click" Margin="3,0"/>
            <Button Style="{StaticResource SmallButton}" Content="×" ToolTip="Скрыть в область уведомлений" Click="Hide_Click" Margin="3,0,0,0"/>
          </StackPanel>
          <StackPanel>
            <TextBlock x:Name="IslandHeaderTitle" Text="Главная" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="18"/>
            <TextBlock x:Name="IslandHeaderSubtitle" Text="NOVA · рабочее пространство" Foreground="{StaticResource MutedInk}" FontSize="10" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
        <Grid x:Name="WorkspaceLayout" Grid.Row="1" Margin="0,8,0,6" SizeChanged="WorkspaceLayout_SizeChanged">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="WidgetNavigationHost" Grid.Row="0" Grid.ColumnSpan="1" CornerRadius="16" Background="#5613161B" BorderBrush="#2AFFFFFF" BorderThickness="1" Padding="4" Margin="0,0,0,6">
            <ScrollViewer x:Name="WidgetNavigationScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="WidgetNavigationList" ItemsPanel="{StaticResource HorizontalWidgetNavigationPanel}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource AdaptiveWidgetNavigationButton}" Height="{Binding NavigationButtonHeight}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" Tag="{Binding Id}" Click="WidgetNavigation_Click" MouseEnter="WidgetNavigation_MouseEnter" MouseLeave="WidgetNavigation_MouseLeave" ToolTip="{Binding Title}">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Glyph}" Foreground="#FFF0A84B" FontSize="{Binding IconSize}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource AdaptiveWidgetNavigationTitle}" VerticalAlignment="Center" MaxWidth="38" Margin="2,0,0,0"/>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <Border x:Name="WidgetContentHost" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="1" CornerRadius="18" Background="#42191C22" BorderBrush="#2AFFFFFF" BorderThickness="1" Padding="10">
            <Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="WidgetPages">
          <StackPanel x:Name="OverviewContent" VerticalAlignment="Center">
            <TextBlock Text="Всё важное — в одной капсуле." Foreground="{StaticResource Ink}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="Музыка, погода, таймер и состояние системы. Передача файлов NOVA остаётся доступна в этой же поверхности." Foreground="{StaticResource MutedInk}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,18"/>
            <Border CornerRadius="16" Background="#18FFFFFF" Padding="14">
              <DockPanel>
                <Border Width="36" Height="36" CornerRadius="12" Background="#28A991FF" DockPanel.Dock="Left"><TextBlock Text="N" Foreground="#C4B5FF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Передача устройств NOVA" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="12"/>
                  <TextBlock Text="Защищённые LAN и WebRTC сценарии сохранены." Foreground="{StaticResource MutedInk}" FontSize="10" Margin="0,3,0,0"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="ModuleContent" Visibility="Collapsed" VerticalAlignment="Center"><TextBlock x:Name="ModuleTitle" Text="Удалённое управление" Style="{StaticResource TitleText}"/><TextBlock x:Name="ModuleDescription" Text="Функция не подключена." Foreground="{StaticResource MutedInk}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,18"/><Border CornerRadius="14" Background="#16FFFFFF" Padding="13"><TextBlock x:Name="ModuleStatus" Text="Недоступно" Foreground="{StaticResource PanelInk}" FontSize="12"/></Border></StackPanel>
          <Grid x:Name="MediaContent" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" x:Name="MediaMainGrid" SizeChanged="MediaMainGrid_SizeChanged" Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="MediaArtworkFrame" Width="160" Height="160" CornerRadius="20" Background="#1FFFFFFF" ClipToBounds="True" HorizontalAlignment="Left">
                <Grid>
                  <Image x:Name="MediaArtworkImage" Stretch="UniformToFill"/>
                  <TextBlock x:Name="MediaArtworkPlaceholder" Text="Обложка недоступна" Foreground="{StaticResource MutedInk}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"/>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="СЕЙЧАС ИГРАЕТ" Foreground="{StaticResource MutedInk}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock x:Name="MediaTitleText" Text="Ничего не воспроизводится" Foreground="{StaticResource Ink}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="MediaArtistText" Text="Запустите любой плеер Windows" Foreground="{StaticResource PanelInk}" FontSize="15" TextWrapping="Wrap" Margin="0,7,0,0"/>
                <TextBlock x:Name="MediaAlbumText" Text="" Foreground="{StaticResource MutedInk}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                <TextBlock x:Name="MediaSourceText" Text="" Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/>
              </StackPanel>
            </Grid>
            <Border Grid.Row="1" CornerRadius="16" Background="#18FFFFFF" Padding="14">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="ТЕКСТ ПЕСНИ · ЯНДЕКС МУЗЫКА" Foreground="{StaticResource MutedInk}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <PasswordBox x:Name="YandexMusicTokenBox" Grid.Column="1" ToolTip="OAuth-токен используется только в памяти текущего запуска NOVA и не записывается в настройки" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,5" FontSize="10" VerticalContentAlignment="Center"/>
                  <Button Grid.Column="2" Style="{StaticResource SmallButton}" Content="Загрузить" Click="LoadYandexLyrics_Click" Padding="9,5" Margin="7,0,0,0"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,6">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <TextBlock x:Name="LyricsStatusText" Grid.Row="0" Text="Вставьте OAuth-токен Яндекс Музыки и нажмите «Загрузить». Используется неофициальный API; токен не сохраняется." Foreground="{StaticResource PanelInk}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
                  <ListBox x:Name="LyricsLinesList" Grid.Row="1" MinHeight="72" Visibility="Collapsed" SelectionChanged="LyricsLinesList_SelectionChanged" Background="Transparent" Foreground="{StaticResource Ink}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource PanelInk}"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Style.Triggers>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#55F0A84B"/>
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock x:Name="LyricLineText" Text="{Binding Text}" TextWrapping="Wrap">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="FontSize" Value="13"/>
                              <Setter Property="Foreground" Value="{StaticResource MutedInk}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                  <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                                  <Setter Property="FontWeight" Value="SemiBold"/>
                                  <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                      <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="FontSize" To="15" Duration="0:0:0.18"/>
                                      </Storyboard>
                                    </BeginStoryboard>
                                  </DataTrigger.EnterActions>
                                  <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                      <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="FontSize" To="13" Duration="0:0:0.18"/>
                                      </Storyboard>
                                    </BeginStoryboard>
                                  </DataTrigger.ExitActions>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <ScrollViewer x:Name="PlainLyricsScroll" Grid.Row="1" MinHeight="72" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="PlainLyricsText" Foreground="{StaticResource PanelInk}" FontSize="13" TextWrapping="Wrap"/>
                  </ScrollViewer>
                </Grid>
                <StackPanel Grid.Row="2" Margin="0,5,0,0">
                  <TextBlock x:Name="MediaStatusText" Text="Ожидание медиасессии Windows…" Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap"/>
                  <TextBlock x:Name="QueueStatusText" Text="Очередь не предоставлена Windows Media Session." ToolTip="Очередь аккаунта Яндекс нельзя надёжно сопоставить с выбранной сессией Windows Media Session." Foreground="{StaticResource MutedInk}" FontSize="8" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"/>
                  <TextBlock x:Name="LyricsSourceStatusText" Text="" Foreground="{StaticResource MutedInk}" FontSize="8" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"/>
                  <TextBlock x:Name="AudioVisualizationStatusText" Text="Аудиореактивность ожидает воспроизведения." Foreground="{StaticResource MutedInk}" FontSize="8" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SmallButton}" Content="|◀" Click="MediaPrevious_Click" Margin="0,0,6,0"/>
                <Button x:Name="MediaPlayPauseButton" Style="{StaticResource SmallButton}" Content="▶" Click="MediaPlayPause_Click" Margin="0,0,6,0"/>
                <Button Style="{StaticResource SmallButton}" Content="▶|" Click="MediaNext_Click"/>
              </StackPanel>
              <TextBlock x:Name="MediaPositionText" Grid.Column="1" Text="0:00" Foreground="{StaticResource MutedInk}" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0"/>
              <Slider x:Name="MediaProgressSlider" Grid.Column="2" Minimum="0" Maximum="1000" ValueChanged="MediaProgress_ValueChanged" PreviewMouseLeftButtonDown="MediaProgress_DragStarted" PreviewMouseLeftButtonUp="MediaProgress_Seek" Margin="8,0"/>
              <TextBlock x:Name="MediaDurationText" Grid.Column="3" Text="0:00" Foreground="{StaticResource MutedInk}" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="3" Margin="0,6,0,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="ГРОМКОСТЬ WINDOWS" Foreground="{StaticResource MutedInk}" FontSize="9" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Slider x:Name="MediaMasterVolumeSlider" Grid.Column="1" Minimum="0" Maximum="1" IsEnabled="False" ValueChanged="MediaMasterVolumeSlider_ValueChanged" Margin="4,0"/>
              <TextBlock x:Name="MediaMasterVolumeText" Grid.Column="2" Text="Недоступно" Foreground="{StaticResource MutedInk}" FontSize="9" VerticalAlignment="Center" MinWidth="54" TextAlignment="Right"/>
              <TextBlock x:Name="MediaMasterVolumeStatusText" Grid.Row="1" Grid.ColumnSpan="3" Text="Регулирует общую громкость Windows, а не только выбранный проигрыватель." Foreground="{StaticResource MutedInk}" FontSize="8" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </Grid>
          </Grid>
          <Grid x:Name="ObsContent" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="OBS STUDIO" Foreground="{StaticResource MutedInk}" FontSize="10" FontWeight="SemiBold"/>
              <TextBlock Text="Управление OBS" Foreground="{StaticResource Ink}" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,2"/>
              <TextBlock x:Name="ObsInstallStatusText" Text="Проверяем установку OBS…" Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap"/>
            </StackPanel>
            <DockPanel Grid.Row="1" Margin="0,10,0,5">
              <Button x:Name="ObsLaunchButton" DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Запустить OBS" Click="ObsLaunch_Click" Margin="6,0,0,0" Padding="9,5"/>
              <TextBlock Text="Локальный сервер · 127.0.0.1" Foreground="{StaticResource PanelInk}" FontSize="10" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid Grid.Row="2" Margin="0,0,0,5">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
              <PasswordBox x:Name="ObsPasswordBox" ToolTip="NOVA использует пароль только для входа и не сохраняет его. OBS может хранить собственный пароль в конфигурации открытым текстом." Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,5"/>
              <TextBox x:Name="ObsPortBox" Grid.Column="1" Text="4455" ToolTip="Локальный порт OBS WebSocket" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="5,5" TextAlignment="Center" Margin="5,0,0,0"/>
            </Grid>
            <WrapPanel Grid.Row="3" Margin="0,0,0,7">
              <Button x:Name="ObsConnectButton" Style="{StaticResource SmallButton}" Content="Подключить" Click="ObsConnect_Click" Margin="0,0,5,0" Padding="9,5"/>
              <Button x:Name="ObsDisconnectButton" Style="{StaticResource SmallButton}" Content="Отключить" Click="ObsDisconnect_Click" IsEnabled="False" Padding="9,5"/>
            </WrapPanel>
            <StackPanel Grid.Row="4">
              <TextBlock x:Name="ObsStatusText" Text="В OBS включите WebSocket-сервер и задайте пароль. NOVA подключается только к 127.0.0.1 и не меняет правила брандмауэра." Foreground="{StaticResource PanelInk}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
              <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Применить сцену" Click="ObsSetScene_Click" Padding="7,4"/>
                <ComboBox x:Name="ObsSceneComboBox" Height="27" Background="#1EFFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" FontSize="10" Margin="0,0,6,0" IsEnabled="False">
                </ComboBox>
              </DockPanel>
              <WrapPanel>
                <Button x:Name="ObsStartRecordingButton" Style="{StaticResource SmallButton}" Content="Начать запись" Click="ObsStartRecording_Click" IsEnabled="False" Margin="0,0,5,0" Padding="9,5"/>
                <Button x:Name="ObsStopRecordingButton" Style="{StaticResource SmallButton}" Content="Остановить запись" Click="ObsStopRecording_Click" IsEnabled="False" Padding="9,5"/>
              </WrapPanel>
              <TextBlock Text="NOVA подключается только к 127.0.0.1 и не меняет Firewall. OBS может слушать все интерфейсы и хранить пароль открытым в своей конфигурации; задайте пароль и ограничьте входящие подключения через Windows Firewall." Foreground="{StaticResource MutedInk}" FontSize="9" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Grid>
          <StackPanel x:Name="ToolsContent" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock Text="ИНСТРУМЕНТЫ NOVA" Foreground="{StaticResource MutedInk}" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock Text="Быстрый доступ" Foreground="{StaticResource Ink}" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,14"/>
            <TextBlock Text="Распознавание Windows OCR · снимок используется только в памяти" Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,5"/>
            <ComboBox x:Name="OcrLanguageComboBox" Height="28" Background="#1EFFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" FontSize="10" Margin="0,0,0,6">
            </ComboBox>
            <Button Style="{StaticResource SmallButton}" Content="Текст с экрана" Click="ScreenText_Click" HorizontalAlignment="Left" Padding="11,6"/>
            <TextBlock x:Name="ScreenTextStatusText" Text="Выделите область для распознавания." Foreground="{StaticResource MutedInk}" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,8"/>
            <UniformGrid Columns="2">
              <Button Style="{StaticResource WidgetNavigationButton}" Tag="Weather" Click="OpenToolWidget_Click"><TextBlock Text="☁  Погода" TextWrapping="Wrap" TextAlignment="Center"/></Button>
              <Button Style="{StaticResource WidgetNavigationButton}" Tag="Transfer" Click="OpenToolWidget_Click"><TextBlock Text="⇧  Передача файлов" TextWrapping="Wrap" TextAlignment="Center"/></Button>
              <Button Style="{StaticResource WidgetNavigationButton}" Tag="History" Click="OpenToolWidget_Click"><TextBlock Text="↺  История" TextWrapping="Wrap" TextAlignment="Center"/></Button>
              <Button Style="{StaticResource WidgetNavigationButton}" Tag="Settings" Click="OpenToolWidget_Click"><TextBlock Text="⚙  Настройки" TextWrapping="Wrap" TextAlignment="Center"/></Button>
            </UniformGrid>
          </StackPanel>
          <StackPanel x:Name="WeatherContent" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock Text="ПОГОДА СЕЙЧАС" Foreground="{StaticResource MutedInk}" FontSize="10" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
              <TextBlock x:Name="WeatherIconText" Text="☁" Foreground="#AFC9FF" FontSize="48" VerticalAlignment="Center" Margin="0,0,18,0"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="WeatherTemperatureText" Text="—°" Foreground="{StaticResource Ink}" FontSize="36" FontWeight="Light"/>
                <TextBlock x:Name="WeatherPlaceText" Text="Укажите город в настройках" Foreground="{StaticResource PanelInk}" FontSize="14"/>
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="WeatherConditionText" Text="Данные Open-Meteo" Foreground="{StaticResource MutedInk}" FontSize="12" Margin="0,4,0,0"/>
            <TextBlock x:Name="WeatherStatusText" Text="Погода ещё не загружена." Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <TextBlock Text="Источник: Open-Meteo · open-meteo.com" Foreground="{StaticResource MutedInk}" FontSize="9" Margin="0,8,0,0"/>
          </StackPanel>
          <StackPanel x:Name="VpnContent" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock Text="VPN · INCI" Foreground="{StaticResource MutedInk}" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock x:Name="VpnStatusText" Text="Проверяем INCY…" Foreground="{StaticResource Ink}" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <TextBlock x:Name="VpnDetailText" Text="" Foreground="{StaticResource MutedInk}" FontSize="12" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,14,0,0">
              <Button x:Name="IncyConnectButton" Style="{StaticResource SmallButton}" Content="Подключить" Click="IncyConnect_Click" Margin="0,0,6,0"/>
              <Button x:Name="IncyDisconnectButton" Style="{StaticResource SmallButton}" Content="Отключить" Click="IncyDisconnect_Click" Margin="0,0,6,0"/>
              <Button x:Name="IncyStatusButton" Style="{StaticResource SmallButton}" Content="Открыть INCY" Click="IncyStatus_Click"/>
            </WrapPanel>
          </StackPanel>
          <StackPanel x:Name="ProductivityContent" Visibility="Collapsed">
            <TextBlock Text="NOVA PRODUCTIVITY" Foreground="{StaticResource MutedInk}" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock Text="Личное рабочее пространство" Foreground="{StaticResource Ink}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,3"/>
            <TextBlock Text="Данные хранятся локально. Напоминания и таймеры работают, пока NOVA запущена, даже если панель скрыта." Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,8">
              <Button Style="{StaticResource SmallButton}" Content="Задачи" Tag="Tasks" Click="ProductivitySection_Click" Margin="0,0,5,4" Padding="8,5"/>
              <Button Style="{StaticResource SmallButton}" Content="Заметки" Tag="Notes" Click="ProductivitySection_Click" Margin="0,0,5,4" Padding="8,5"/>
              <Button Style="{StaticResource SmallButton}" Content="Таймеры" Tag="Timers" Click="ProductivitySection_Click" Margin="0,0,5,4" Padding="8,5"/>
              <Button Style="{StaticResource SmallButton}" Content="Напоминания" Tag="Reminders" Click="ProductivitySection_Click" Margin="0,0,5,4" Padding="8,5"/>
              <Button Style="{StaticResource SmallButton}" Content="Календарь" Tag="Calendar" Click="ProductivitySection_Click" Margin="0,0,5,4" Padding="8,5"/>
              <Button Style="{StaticResource SmallButton}" Content="Память" Tag="Memory" Click="ProductivitySection_Click" Margin="0,0,5,4" Padding="8,5"/>
              <Button Style="{StaticResource SmallButton}" Content="Действия" Tag="Actions" Click="ProductivitySection_Click" Margin="0,0,5,4" Padding="8,5"/>
            </WrapPanel>
            <TextBlock x:Name="ProductivityStatusText" Text="Локальное хранилище готово." Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <StackPanel x:Name="ProductivityTasksSection">
              <Border CornerRadius="12" Background="#18FFFFFF" Padding="10" Margin="0,0,0,9">
                <StackPanel>
                  <TextBlock Text="Задача · автосохранение" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="SemiBold"/>
                  <TextBox x:Name="ProductivityTaskTitleBox" ToolTip="Название задачи" TextChanged="ProductivityTaskForm_Changed" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,5" Margin="0,6,0,0"/>
                  <TextBox x:Name="ProductivityTaskDetailsBox" ToolTip="Описание (необязательно)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" MaxHeight="72" TextChanged="ProductivityTaskForm_Changed" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,5" Margin="0,5,0,0"/>
                  <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ProductivityTaskCategoryBox" ToolTip="Категория" TextChanged="ProductivityTaskForm_Changed" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="6,4" Margin="0,0,4,0"/>
                    <ComboBox x:Name="ProductivityTaskPriorityCombo" Grid.Column="1" SelectionChanged="ProductivityTaskForm_SelectionChanged" Background="#1EFFFFFF" Foreground="{StaticResource Ink}" Padding="4,3" Margin="0,0,4,0">
                      <ComboBoxItem Content="Обычный" Tag="Normal" IsSelected="True"/>
                      <ComboBoxItem Content="Высокий" Tag="High"/>
                      <ComboBoxItem Content="Низкий" Tag="Low"/>
                    </ComboBox>
                    <DatePicker x:Name="ProductivityTaskDueDatePicker" Grid.Column="2" SelectedDateChanged="ProductivityTaskForm_DateChanged" Background="#16FFFFFF" Foreground="{StaticResource Ink}" Margin="0,0,4,0"/>
                    <TextBox x:Name="ProductivityTaskDueTimeBox" Grid.Column="3" ToolTip="Срок, ЧЧ:ММ" TextChanged="ProductivityTaskForm_Changed" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="5,4"/>
                  </Grid>
                  <WrapPanel Margin="0,4,0,0">
                    <CheckBox x:Name="ProductivityTaskPinnedCheckBox" Content="Закрепить" Foreground="{StaticResource PanelInk}" Click="ProductivityTaskForm_Changed" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource SmallButton}" Content="Сохранить" Click="ProductivityTaskSave_Click" Padding="8,4" Margin="0,0,5,0"/>
                    <Button Style="{StaticResource SmallButton}" Content="Очистить" Click="ProductivityTaskClear_Click" Padding="8,4"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <TextBox x:Name="ProductivityTaskSearchBox" ToolTip="Поиск по задачам" TextChanged="ProductivityTaskSearch_TextChanged" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,5" Margin="0,0,0,7"/>
              <ItemsControl x:Name="ProductivityTaskList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="10" Background="#18FFFFFF" Padding="9" Margin="0,0,0,6">
                      <StackPanel>
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding PriorityText}" Foreground="#FFF0A84B" FontSize="9" Margin="8,0,0,0"/>
                          <TextBlock Text="{Binding Title}" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Details}" Foreground="{StaticResource PanelInk}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding MetaText}" Foreground="{StaticResource MutedInk}" FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <WrapPanel Margin="0,5,0,0">
                          <Button Tag="{Binding}" Content="{Binding CompletionText}" Click="ProductivityTaskToggle_Click" Style="{StaticResource SmallButton}" Padding="7,4" Margin="0,0,5,0"/>
                          <Button Tag="{Binding}" Content="Изменить" Click="ProductivityTaskEdit_Click" Style="{StaticResource SmallButton}" Padding="7,4" Margin="0,0,5,0"/>
                          <Button Tag="{Binding}" Content="Удалить" Click="ProductivityTaskDelete_Click" Style="{StaticResource SmallButton}" Padding="7,4"/>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel x:Name="ProductivityNotesSection" Visibility="Collapsed">
              <Border CornerRadius="12" Background="#18FFFFFF" Padding="10" Margin="0,0,0,9">
                <StackPanel>
                  <TextBlock Text="Заметка · автосохранение" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="SemiBold"/>
                  <TextBox x:Name="ProductivityNoteTitleBox" ToolTip="Название заметки" TextChanged="ProductivityNoteForm_Changed" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,5" Margin="0,6,0,0"/>
                  <TextBox x:Name="ProductivityNoteContentBox" ToolTip="Текст заметки" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="180" VerticalScrollBarVisibility="Auto" TextChanged="ProductivityNoteForm_Changed" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,5" Margin="0,5,0,0"/>
                  <WrapPanel Margin="0,5,0,0">
                    <TextBox x:Name="ProductivityNoteCategoryBox" ToolTip="Категория" Width="140" TextChanged="ProductivityNoteForm_Changed" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="6,4" Margin="0,0,6,0"/>
                    <CheckBox x:Name="ProductivityNotePinnedCheckBox" Content="Закрепить" Foreground="{StaticResource PanelInk}" Click="ProductivityNoteForm_Changed" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SmallButton}" Content="Сохранить" Click="ProductivityNoteSave_Click" Padding="8,4" Margin="0,0,5,0"/>
                    <Button Style="{StaticResource SmallButton}" Content="Очистить" Click="ProductivityNoteClear_Click" Padding="8,4"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <TextBox x:Name="ProductivityNoteSearchBox" ToolTip="Поиск по заметкам" TextChanged="ProductivityNoteSearch_TextChanged" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,5" Margin="0,0,0,7"/>
              <ItemsControl x:Name="ProductivityNoteList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="10" Background="#18FFFFFF" Padding="9" Margin="0,0,0,6">
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Content}" Foreground="{StaticResource PanelInk}" FontSize="10" TextWrapping="Wrap" MaxHeight="80" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding MetaText}" Foreground="{StaticResource MutedInk}" FontSize="9" Margin="0,3,0,0"/>
