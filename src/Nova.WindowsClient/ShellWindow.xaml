<Window x:Class="Nova.WindowsClient.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Панель NOVA" Width="540" Height="84" MinWidth="380" MinHeight="64" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" Loaded="Window_Loaded" Closing="Window_Closing" SizeChanged="Window_SizeChanged" LocationChanged="Window_LocationChanged" PreviewKeyDown="Window_PreviewKeyDown" MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave" Deactivated="Window_Deactivated">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
    <DropShadowEffect x:Key="OverlayTextShadow" BlurRadius="2" ShadowDepth="1" Opacity="0.9" Color="#FF000000"/>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource NavButton}"><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
    <Style x:Key="TitleText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="SettingsNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}"><Setter Property="Padding" Value="8,7"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
    <Style x:Key="WidgetNavigationButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Background" Value="#35F0A84B"/>
          <Setter Property="BorderBrush" Value="#9AF0A84B"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Border x:Name="PanelSurface" Margin="0" CornerRadius="40" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
    <Grid>
      <Path x:Name="CapsuleGlowPath" Stroke="#A8F0A84B" StrokeThickness="5" Opacity="0.13" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SnapsToDevicePixels="True" IsHitTestVisible="False"/>
      <Path x:Name="CapsuleSurfacePath" Stroke="#FF51402F" StrokeThickness="1" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SnapsToDevicePixels="True" IsHitTestVisible="False">
        <Path.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF1B1B20" Offset="0"/>
            <GradientStop Color="#FF0C0C0F" Offset="0.48"/>
            <GradientStop Color="#FF050506" Offset="1"/>
          </LinearGradientBrush>
        </Path.Fill>
      </Path>
      <Grid x:Name="CompactView" Margin="18,10" Visibility="Collapsed">
        <Grid x:Name="CapsuleContentGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="CapsuleClockBlock" VerticalAlignment="Center" Margin="0,0,7,0">
            <TextBlock x:Name="ClockText" Text="--:--" Foreground="{StaticResource Ink}" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock x:Name="ClockDateText" Text="NOVA" Foreground="{StaticResource MutedInk}" FontSize="9" Margin="1,1,0,0"/>
          </StackPanel>
          <Border x:Name="CapsuleWeatherBlock" Grid.Column="1" Background="Transparent" CornerRadius="16" Padding="6,7" Margin="0,0,5,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="CompactWeatherIcon" Text="☁" Foreground="#AFC9FF" FontSize="19" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="CompactWeatherTemperature" Text="—°" Foreground="{StaticResource Ink}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock x:Name="CompactWeatherPlace" Text="Погода" Foreground="{StaticResource MutedInk}" FontSize="9" TextTrimming="CharacterEllipsis" MaxWidth="76"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Button x:Name="CompactMediaButton" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="5,4" Click="CompactMedia_Click" HorizontalContentAlignment="Stretch">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="CompactArtworkFrame" Width="34" Height="34" CornerRadius="10" Background="#FF101010" ClipToBounds="True" Visibility="Collapsed">
                <Image x:Name="CompactArtworkImage" Stretch="UniformToFill"/>
              </Border>
              <StackPanel x:Name="CompactMediaInfo" Grid.Column="1" Margin="8,0,2,0" VerticalAlignment="Center">
                <TextBlock x:Name="CompactMediaTitle" Text="Нет активного трека" Foreground="{StaticResource Ink}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CompactMediaArtist" Text="Ожидание медиасессии" Foreground="{StaticResource MutedInk}" FontSize="9" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CompactMediaState" Text="" Foreground="#FFC99B" FontSize="8" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Button>
          <Border x:Name="CapsuleStatusBlock" Grid.Column="3" Background="Transparent" CornerRadius="15" Padding="5,5,2,5" Margin="1,0,0,0" VerticalAlignment="Center">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ActivityDot" Width="6" Height="6" Fill="#63D7B3" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock x:Name="CompactActivityText" Text="Готово" Foreground="{StaticResource PanelInk}" FontSize="9" VerticalAlignment="Center" MaxWidth="112" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <TextBlock x:Name="CompactMetricsText" Text="" Foreground="{StaticResource MutedInk}" FontSize="8" TextWrapping="Wrap" MaxWidth="125" Margin="1,2,0,0"/>
              <TextBlock x:Name="CompactNetworkText" Text="" Foreground="#FFAFC9FF" FontSize="8" TextTrimming="CharacterEllipsis" MaxWidth="125" Margin="1,1,0,0" Visibility="Collapsed"/>
              <TextBlock x:Name="CompactVpnText" Text="" Foreground="#FFBFE4D9" FontSize="8" TextTrimming="CharacterEllipsis" MaxWidth="125" Margin="1,1,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <Grid x:Name="MainView" Margin="18,14" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="4,0,4,12">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="DockToggleButton" Style="{StaticResource SmallButton}" Content="Открепить" ToolTip="Открепить и перемещать панель" Click="DockToggle_Click" Padding="9,4" Margin="0,0,5,0"/>
            <Button Style="{StaticResource SmallButton}" Content="×" ToolTip="Скрыть в область уведомлений" Click="Hide_Click" Padding="9,4"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="NOVA" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="13"/>
            <TextBlock Text="  ·  Быстрые функции" Foreground="{StaticResource MutedInk}" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </DockPanel>
        <UniformGrid Grid.Row="1" Rows="2" Columns="3">
          <Button Style="{StaticResource NavButton}" Click="HomeIsland_Click" Padding="7,7" Margin="3,2"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="⌂" Foreground="#B9A7FF" FontSize="19" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Главная" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Style="{StaticResource NavButton}" Click="Music_Click" Padding="7,7" Margin="3,2"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="♫" Foreground="#FF9CCB" FontSize="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Музыка" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Style="{StaticResource NavButton}" Click="Vpn_Click" Padding="7,7" Margin="3,2"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="◇" Foreground="#87CFFF" FontSize="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="VPN" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Style="{StaticResource NavButton}" Click="Timer_Click" Padding="7,7" Margin="3,2"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="◷" Foreground="#FFC27A" FontSize="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Таймер" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Style="{StaticResource NavButton}" Click="System_Click" Padding="7,7" Margin="3,2"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="⌁" Foreground="#70DDB8" FontSize="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Система" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Style="{StaticResource NavButton}" Click="Settings_Click" Padding="7,7" Margin="3,2"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="⚙" Foreground="#C3CCDD" FontSize="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Настройки" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button>
        </UniformGrid>
      </Grid>
      <Grid x:Name="ExpandedView" Margin="20" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="FullscreenToggleButton" Style="{StaticResource SmallButton}" Content="⛶  На весь экран" ToolTip="Открыть полноэкранное пространство" Click="ToggleFullscreen_Click" Margin="3,0"/>
            <Button Style="{StaticResource SmallButton}" Content="⌃" ToolTip="Свернуть до капсулы" Click="CollapseToCapsule_Click" Margin="3,0"/>
            <Button Style="{StaticResource SmallButton}" Content="×" ToolTip="Скрыть в область уведомлений" Click="Hide_Click" Margin="3,0,0,0"/>
          </StackPanel>
          <StackPanel>
            <TextBlock x:Name="IslandHeaderTitle" Text="Главная" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="18"/>
            <TextBlock x:Name="IslandHeaderSubtitle" Text="NOVA · рабочее пространство" Foreground="{StaticResource MutedInk}" FontSize="10" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
        <Grid x:Name="WorkspaceLayout" Grid.Row="1" Margin="0,14,0,8" SizeChanged="WorkspaceLayout_SizeChanged">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="WidgetNavigationColumn" Width="190"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" CornerRadius="18" Background="#42191C22" BorderBrush="#2AFFFFFF" BorderThickness="1" Padding="15" Margin="0,0,12,0">
            <Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="WidgetPages">
          <StackPanel x:Name="OverviewContent" VerticalAlignment="Center">
            <TextBlock Text="Всё важное — в одной капсуле." Foreground="{StaticResource Ink}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="Музыка, погода, таймер и состояние системы. Передача файлов NOVA остаётся доступна в этой же поверхности." Foreground="{StaticResource MutedInk}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,18"/>
            <Border CornerRadius="16" Background="#18FFFFFF" Padding="14">
              <DockPanel>
                <Border Width="36" Height="36" CornerRadius="12" Background="#28A991FF" DockPanel.Dock="Left"><TextBlock Text="N" Foreground="#C4B5FF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Передача устройств NOVA" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="12"/>
                  <TextBlock Text="Защищённые LAN и WebRTC сценарии сохранены." Foreground="{StaticResource MutedInk}" FontSize="10" Margin="0,3,0,0"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="ModuleContent" Visibility="Collapsed" VerticalAlignment="Center"><TextBlock x:Name="ModuleTitle" Text="Удалённое управление" Style="{StaticResource TitleText}"/><TextBlock x:Name="ModuleDescription" Text="Функция не подключена." Foreground="{StaticResource MutedInk}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,18"/><Border CornerRadius="14" Background="#16FFFFFF" Padding="13"><TextBlock x:Name="ModuleStatus" Text="Недоступно" Foreground="{StaticResource PanelInk}" FontSize="12"/></Border></StackPanel>
          <Grid x:Name="MediaContent" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" x:Name="MediaMainGrid" SizeChanged="MediaMainGrid_SizeChanged" Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="MediaArtworkFrame" Width="160" Height="160" CornerRadius="20" Background="#1FFFFFFF" ClipToBounds="True" HorizontalAlignment="Left">
                <Grid>
                  <Image x:Name="MediaArtworkImage" Stretch="UniformToFill"/>
                  <TextBlock x:Name="MediaArtworkPlaceholder" Text="Обложка недоступна" Foreground="{StaticResource MutedInk}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"/>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="СЕЙЧАС ИГРАЕТ" Foreground="{StaticResource MutedInk}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock x:Name="MediaTitleText" Text="Ничего не воспроизводится" Foreground="{StaticResource Ink}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="MediaArtistText" Text="Запустите любой плеер Windows" Foreground="{StaticResource PanelInk}" FontSize="15" TextWrapping="Wrap" Margin="0,7,0,0"/>
                <TextBlock x:Name="MediaAlbumText" Text="" Foreground="{StaticResource MutedInk}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                <TextBlock x:Name="MediaSourceText" Text="" Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/>
              </StackPanel>
            </Grid>
            <Border Grid.Row="1" CornerRadius="16" Background="#18FFFFFF" Padding="14">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="ТЕКСТ ПЕСНИ · ЯНДЕКС МУЗЫКА" Foreground="{StaticResource MutedInk}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <PasswordBox x:Name="YandexMusicTokenBox" Grid.Column="1" ToolTip="OAuth-токен используется только в памяти текущего запуска NOVA и не записывается в настройки" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,5" FontSize="10" VerticalContentAlignment="Center"/>
                  <Button Grid.Column="2" Style="{StaticResource SmallButton}" Content="Загрузить" Click="LoadYandexLyrics_Click" Padding="9,5" Margin="7,0,0,0"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,8">
                  <TextBlock x:Name="LyricsStatusText" Text="Вставьте OAuth-токен Яндекс Музыки и нажмите «Загрузить». Используется неофициальный API; токен не сохраняется." Foreground="{StaticResource PanelInk}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  <ListBox x:Name="LyricsLinesList" Visibility="Collapsed" SelectionChanged="LyricsLinesList_SelectionChanged" Background="Transparent" Foreground="{StaticResource Ink}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource PanelInk}"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Style.Triggers>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#55F0A84B"/>
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"/></DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <ScrollViewer x:Name="PlainLyricsScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="PlainLyricsText" Foreground="{StaticResource PanelInk}" FontSize="13" TextWrapping="Wrap"/>
                  </ScrollViewer>
                </Grid>
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                  <TextBlock x:Name="MediaStatusText" Text="Ожидание медиасессии Windows…" Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap"/>
                  <TextBlock x:Name="QueueStatusText" Text="Очередь текущей Windows Media Session не раскрыта; очередь аккаунта Яндекс нельзя надёжно сопоставить с выбранной сессией." Foreground="{StaticResource MutedInk}" FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0"/>
                  <TextBlock x:Name="LyricsSourceStatusText" Text="" Foreground="{StaticResource MutedInk}" FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0"/>
                  <TextBlock x:Name="AudioVisualizationStatusText" Text="Аудиореактивность ожидает воспроизведения." Foreground="{StaticResource MutedInk}" FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SmallButton}" Content="|◀" Click="MediaPrevious_Click" Margin="0,0,6,0"/>
                <Button x:Name="MediaPlayPauseButton" Style="{StaticResource SmallButton}" Content="▶" Click="MediaPlayPause_Click" Margin="0,0,6,0"/>
                <Button Style="{StaticResource SmallButton}" Content="▶|" Click="MediaNext_Click"/>
              </StackPanel>
              <TextBlock x:Name="MediaPositionText" Grid.Column="1" Text="0:00" Foreground="{StaticResource MutedInk}" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0"/>
              <Slider x:Name="MediaProgressSlider" Grid.Column="2" Minimum="0" Maximum="1000" ValueChanged="MediaProgress_ValueChanged" PreviewMouseLeftButtonDown="MediaProgress_DragStarted" PreviewMouseLeftButtonUp="MediaProgress_Seek" Margin="8,0"/>
              <TextBlock x:Name="MediaDurationText" Grid.Column="3" Text="0:00" Foreground="{StaticResource MutedInk}" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="3" Margin="0,10,0,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="ГРОМКОСТЬ WINDOWS" Foreground="{StaticResource MutedInk}" FontSize="9" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Slider x:Name="MediaMasterVolumeSlider" Grid.Column="1" Minimum="0" Maximum="1" IsEnabled="False" ValueChanged="MediaMasterVolumeSlider_ValueChanged" Margin="4,0"/>
              <TextBlock x:Name="MediaMasterVolumeText" Grid.Column="2" Text="Недоступно" Foreground="{StaticResource MutedInk}" FontSize="9" VerticalAlignment="Center" MinWidth="54" TextAlignment="Right"/>
              <TextBlock x:Name="MediaMasterVolumeStatusText" Grid.Row="1" Grid.ColumnSpan="3" Text="Регулирует общую громкость Windows, а не только выбранный проигрыватель." Foreground="{StaticResource MutedInk}" FontSize="8" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </Grid>
          </Grid>
          <Grid x:Name="ObsContent" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="OBS STUDIO" Foreground="{StaticResource MutedInk}" FontSize="10" FontWeight="SemiBold"/>
              <TextBlock Text="Управление OBS" Foreground="{StaticResource Ink}" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,2"/>
              <TextBlock x:Name="ObsInstallStatusText" Text="Проверяем установку OBS…" Foreground="{StaticResource MutedInk}" FontSize="10" TextWrapping="Wrap"/>
            </StackPanel>
            <DockPanel Grid.Row="1" Margin="0,10,0,5">
              <Button x:Name="ObsLaunchButton" DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Запустить OBS" Click="ObsLaunch_Click" Margin="6,0,0,0" Padding="9,5"/>
              <TextBlock Text="Локальный сервер · 127.0.0.1" Foreground="{StaticResource PanelInk}" FontSize="10" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid Grid.Row="2" Margin="0,0,0,5">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
              <PasswordBox x:Name="ObsPasswordBox" ToolTip="NOVA использует пароль только для входа и не сохраняет его. OBS может хранить собственный пароль в конфигурации открытым текстом." Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="7,5"/>
              <TextBox x:Name="ObsPortBox" Grid.Column="1" Text="4455" ToolTip="Локальный порт OBS WebSocket" Background="#16FFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" Padding="5,5" TextAlignment="Center" Margin="5,0,0,0"/>
            </Grid>
            <WrapPanel Grid.Row="3" Margin="0,0,0,7">
              <Button x:Name="ObsConnectButton" Style="{StaticResource SmallButton}" Content="Подключить" Click="ObsConnect_Click" Margin="0,0,5,0" Padding="9,5"/>
              <Button x:Name="ObsDisconnectButton" Style="{StaticResource SmallButton}" Content="Отключить" Click="ObsDisconnect_Click" IsEnabled="False" Padding="9,5"/>
            </WrapPanel>
            <StackPanel Grid.Row="4">
              <TextBlock x:Name="ObsStatusText" Text="В OBS включите WebSocket-сервер и задайте пароль. NOVA подключается только к 127.0.0.1 и не меняет правила брандмауэра." Foreground="{StaticResource PanelInk}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
              <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Применить сцену" Click="ObsSetScene_Click" Padding="7,4"/>
                <ComboBox x:Name="ObsSceneComboBox" Height="27" Background="#1EFFFFFF" Foreground="{StaticResource Ink}" BorderBrush="#24FFFFFF" FontSize="10" Margin="0,0,6,0" IsEnabled="False">
                  <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#FF141414"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style></ComboBox.ItemContainerStyle>
                </ComboBox>
              </DockPanel>
              <WrapPanel>
                <Button x:Name="ObsStartRecordingButton" Style="{StaticResource SmallButton}" Content="Начать запись" Click="ObsStartRecording_Click" IsEnabled="False" Margin="0,0,5,0" Padding="9,5"/>
                <Button x:Name="ObsStopRecordingButton" Style="{StaticResource SmallButton}" Content="Остановить запись" Click="ObsStopRecording_Click" IsEnabled="False" Padding="9,5"/>
              </WrapPanel>
              <TextBlock Text="NOVA подключается только к 127.0.0.1 и не меняет Firewall. OBS может слушать все интерфейсы и хранить пароль открытым в своей конфигурации; задайте пароль и ограничьте входящие подключения через Windows Firewall." Foreground="{StaticResource MutedInk}" FontSize="9" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Grid>
          <StackPanel x:Name="ToolsContent" Visibility="Collapsed" VerticalAlignment="Center">
