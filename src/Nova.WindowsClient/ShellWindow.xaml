                          <Button Tag="{Binding}" Content="Удалить" Click="ProductivityActionDelete_Click" Style="{StaticResource SmallButton}" Padding="7,4"/>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border CornerRadius="12" Background="#18FFFFFF" Padding="10" Margin="0,6,0,9">
